@startuml
abstract class Користувач {
- ідентифікатор: Int
- логін: String
- пароль: String

- електроннаПошта: String
- статус: String
+ увійти(): Boolean
+ вийти(): void
+ змінитиПароль(): Boolean
+ оновитиДані(): void
+ перевіритиСтатус(): String }
abstract class Співробітник {
- номерСпівробітника: Int
- посада: String
- датаПрийому: Date
- ставка: Float
- номерТелефону: String
+ отриматиЗарплату(): Float
+ взятиВідпустку(): Boolean
+ відмітитиПрихід(): void
+ відмітитиУхід(): void
+ переглянутиГрафік(): String }
class Керівник {
- відділ: String
- рівеньДоступу: Int
- кількістьПідлеглих: Int
- бюджет: Float

- премія: Float
+ згенеруватиЗвіт(): void
+ затвердитиЗамовлення(з: Замовлення): Boolean
+ призначитиЗавдання(): void
+ переглянутиАналітику(): void
+ нарахуватиПремію(): void }
class Комірник {
- зміна: String
- ліцензіяНаНавантажувач: Boolean
- секторСкладу: String
- обробленіТовари: Int
- робочіГодини: Float
+ прийнятиТовар(): Boolean
+ видатиТовар(): Boolean
+ провестиІнвентаризацію(): void
+ оновитиЗалишки(): void
+ надрукуватиЕтикетку(): void
}
class Товар {
- кодТовару: Int
- назва: String
- штрихКод: String
- ціна: Float

- кількість: Int
+ оновитиЦіну(новаЦіна: Float): void
+ додатиНаСклад(кільк: Int): void
+ списатиЗіСкладу(кільк: Int): Boolean
+ отриматиДеталі(): String
+ перевіритиНаявність(): Boolean
}
class Категорія {
- кодКатегорії: Int
- назва: String
- опис: String
- ставкаПодатку: Float
- батьківськаКатегорія: String
+ додатиТовар(т: Товар): void
+ видалитиТовар(т: Товар): void
+ оновитиОпис(новийОпис: String): void
+ розрахуватиПодаток(): Float
+ отриматиПідкатегорії(): List }
class Замовлення {
- номерЗамовлення: Int
- датаЗамовлення: Date
- статус: String
- загальнаСума: Float

- адресаДоставки: String
+ створитиЗамовлення(): void
+ скасуватиЗамовлення(): Boolean
+ оновитиСтатус(новийСтатус: String): void
+ розрахуватиПідсумок(): Float
+ надрукуватиНакладну(): void }
class ПозиціяЗамовлення {
- кодПозиції: Int
- кількість: Int
- цінаЗаОдиницю: Float
- знижка: Float
- загальнаВартість: Float
+ розрахуватиВартістьПозиції(): Float
+ застосуватиЗнижку(відсоток: Float): void
+ оновитиКількість(к: Int): void
+ отриматиДеталіТовару(): String
+ перевіритиЗалишок(): Boolean }
class Постачальник {
- кодПостачальника: Int
- назваКомпанії: String
- контактнаОсоба: String
- телефон: String
- електроннаПошта: String

+ додатиПостачальника(): void
+ оновитиКонтакти(тел: String): void
+ зробитиЗамовленняНаПостачання(): Boolean
+ отриматиІсторію(): List
+ оцінитиПостачальника(): Float }
class ДокументІнвентаризації {
- номерДокумента: Int
- датаСтворення: Date
- тип: String
- кодАвтора: Int
- примітки: String
+ створитиДокумент(): void
+ затвердитиДокумент(): Boolean
+ надрукуватиДокумент(): void
+ прикріпитиФайл(шлях: String): void
+ отриматиСтатус(): String }
class Склад {
- номерСкладу: Int
- адреса: String
- місткість: Int
- поточнеЗавантаження: Int
- температура: Float
+ перевіритиВільнеМісце(): Boolean

+ прийнятиВантаж(): void
+ відвантажити(): void
+ встановитиТемпературу(т: Float): void
+ згенеруватиКарту(): String }
' --- ЗВ'ЯЗКИ МІЖ КЛАСАМИ ---
' 1. Наслідування
Співробітник --|> Користувач : наслідує
Керівник --|> Співробітник : наслідує
Комірник --|> Співробітник : наслідує
' 2. Інстанціювання (Залежність)
Керівник ..> Замовлення : інстанціювання
Комірник ..> ДокументІнвентаризації : інстанціювання
' 3. Асоціація (Склад і Товар тепер 1 до 1)
Склад "1" --> "1" Товар : асоціація
Постачальник "1" --> "0..*" Товар : асоціація
ПозиціяЗамовлення "0..*" --> "1" Товар : асоціація
' 4. Агрегація
Категорія "1" o-- "0..*" Товар : агрегація
' 5. Композиція
Замовлення "1" *-- "1..*" ПозиціяЗамовлення : композиція
@enduml